---
export const prerender = true;
import { t } from "../lib/i18n";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Critico - About (SSG)</title>
  </head>
  <body class="bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-white min-h-screen flex flex-col items-center justify-center p-4">
    <div class="max-w-2xl text-center space-y-6">
      <h1 class="text-4xl font-bold text-sky-500">Critico</h1>
      <div class="p-6 rounded-2xl bg-white dark:bg-gray-800 shadow-xl border border-gray-200 dark:border-gray-700">
        <h2 class="text-2xl font-semibold mb-4">Hybrid Rendering Demo</h2>
        <p class="mb-4">
          This page is <strong>Statically Generated (SSG)</strong>.
        </p>
        <p class="text-gray-600 dark:text-gray-400">
          The rest of the application uses <strong>Server-Side Rendering (SSR)</strong> 
          combined with <strong>Client-Side Rendering (SPA)</strong> for maximum interactivity.
        </p>
      </div>
      <a href="/home" class="inline-block px-6 py-3 bg-sky-600 hover:bg-sky-700 text-white rounded-lg transition-colors">
        Go to App (SSR/SPA)
      </a>
    </div>
  </body>
</html>

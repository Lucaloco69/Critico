---
import App from '../app';
import '../index.css';

Astro.response.headers.set('Cache-Control', 'public, max-age=0, must-revalidate');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <meta name="description" content="Critico is your trusted platform for product reviews and ratings. Share your experiences and discover top-rated products." />
    <title>Critico</title>
  </head>
  <body>
    <div id="root">
        <App client:load url={Astro.request.url} />
    </div>
  </body>
</html>
